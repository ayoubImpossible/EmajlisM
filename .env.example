# Adresse du serveur Express (emajlis-api).
#
# Expo n'injecte dans le bundle que les variables préfixées EXPO_PUBLIC_.
# Elle est lue par src/config/env.js, seul endroit qui décide de l'adresse.
#
# Développement (Express sur le poste, téléphone sur le même réseau Wi-Fi) :
#   EXPO_PUBLIC_BASE_URL=http://192.168.7.61:3000
#
# Production : HTTPS obligatoire — le jeton d'authentification circule dans
# l'en-tête Authorization, en clair sur HTTP.
#   EXPO_PUBLIC_BASE_URL=https://api.emajlis.csefrs.ma
#
# Sans cette variable, l'application retombe en développement sur l'hôte qui
# sert Metro, port 3000, et le signale dans la console. En production, son
# absence est une erreur : aucun appel n'aboutira.

EXPO_PUBLIC_BASE_URL=http://192.168.7.61:3000
